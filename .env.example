# ====== Poe API 配置 ======
# API Key (必填) - 从 https://poe.com/api_key 获取
POE_API_KEY=your_poe_api_key_here

# Poe API Base URL
POE_BASE_URL=https://api.poe.com/v1

# 模型选择
POE_MODEL=GPT-5.4

# 可选: 请求头信息
POE_SITE_URL=http://localhost:3000
POE_APP_NAME=lianghua-multi-agent

# Tushare Token
TUSHARE_TOKEN=your_tushare_token

# RAG settings
RAG_ENABLE=true
RAG_KNOWLEDGE_DIR=knowledge
RAG_CHROMA_DIR=.chroma
ALPHA101_MD_PATH=data/Alpha101.md
RAG_TOP_K=4
POE_EMBEDDING_MODEL=text-embedding-3-small
