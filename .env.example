# Example environment variables
# Add your Poe API key here to try Poe via POE_API_KEY
# Example:
# POE_API_KEY=your_poe_api_key_here

# Existing OpenRouter/OpenAI-compatible examples:
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your_openai_key_here# ====== OpenRouter 配置 ======
# API Key (必填) - 从 https://openrouter.ai 获取
OPENROUTER_API_KEY=your_openrouter_api_key

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 模型选择 (重要!)
# ⚠️  如果遇到 403 错误 "model not available in your region"，
#    请更换为下列已验证可用的模型：
# 
# 推荐 (按优先级):
#   1. anthropic/claude-3.5-sonnet      ← 最推荐，性能最强
#   2. deepseek/deepseek-chat           ← 国产，本土优化
#   3. meta-llama/llama-2-70b-chat      ← 开源，稳定可靠
#
# 默认 (如果上面的都不好用):
#   - openai/gpt-4o-mini
#   - mistralai/mistral-large
#
# 诊断模型问题: python examples/diagnose.py
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 可选: OpenRouter 排名用的请求头
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=lianghua-multi-agent

# Tushare Token
TUSHARE_TOKEN=your_tushare_token

# RAG settings
RAG_ENABLE=true
RAG_KNOWLEDGE_DIR=knowledge
RAG_CHROMA_DIR=.chroma
ALPHA101_MD_PATH=data/Alpha101.md
RAG_TOP_K=4
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
